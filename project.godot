; Engine configuration file.
; https://docs.godotengine.org/en/stable/tutorials/misc/config_file_principle.html

config_version=5

[application]

config/name="Supersmash"
config/features=PackedStringArray("4.3", "C#")

[dotnet]

project/assembly_name="Supersmash"

[physics]

; 60 ticks = 1 "frame" in our frame-count budget.
; Every timer, buffer window, and hitstun value is expressed in these ticks.
common/physics_ticks_per_second=60

