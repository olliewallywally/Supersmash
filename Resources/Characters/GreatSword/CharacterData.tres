; GreatSword — heavy swordfighter archetype.
; Inspired by Cloud Strife (FF7 / Smash Bros Ultimate).
; Long range sword attacks, great jump, medium-heavy weight.
; Reward: massive kill power. Risk: slow startup on big attacks.
[gd_resource type="Resource" script_class="CharacterData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Character/CharacterData.cs" id="Script_CharacterData"]

[resource]
script = ExtResource("Script_CharacterData")

; ── Identity ──────────────────────────────────────────────────────────────────
; Heavier than Marth (87) and lighter than Falcon (104). Survives to ~130%.
Weight = 95.0

; ── Ground Movement ───────────────────────────────────────────────────────────
; Slow walk — Cloud is not a rushdown character.
WalkSpeed = 520.0
RunSpeed = 1150.0
InitialDashSpeed = 1350.0
GroundFriction = 0.16
TurnaroundFriction = 0.28

; ── Dash & Dash-Dance ─────────────────────────────────────────────────────────
InitialDashFrames = 11
DashDanceWindowFrames = 11
FoxtrotCooldownFrames = 2

; ── Jumping ───────────────────────────────────────────────────────────────────
JumpSquatFrames = 5
FullHopVelocity = -1480.0
ShortHopVelocity = -870.0
AirJumpVelocity = -1380.0
MaxAirJumps = 1
JumpMomentumTransfer = 0.75
