; ── Air Movement ──────────────────────────────────────────────────────────────
; Medium-slow air speed — not a rushdown aerial character.
AirSpeed = 580.0
AirAcceleration = 0.06
AirFriction = 0.012

; ── Gravity & Fall ────────────────────────────────────────────────────────────
; Floatier than Fox/Falco — better aerial presence.
Gravity = 2600.0
MaxFallSpeed = 2200.0
FastFallMultiplier = 1.55
FastFallMaxSpeed = 3050.0

; ── Landing Lag ───────────────────────────────────────────────────────────────
SoftLandingFrames = 2
