LedgeGrabBoxSize = Vector2(24, 38)
LedgeHangInvincibilityFrames = 30
LedgeRegrabCooldownFrames = 35
LedgeGetupFrames = 24

; ── Hurtbox Sizing ────────────────────────────────────────────────────────────
; Tall but somewhat wide — a big target.
StandingHurtboxSize = Vector2(40, 88)
CrouchHurtboxSize = Vector2(44, 54)

; ── Shield ────────────────────────────────────────────────────────────────────
; Strong shield — compensates for slower OOS options.
