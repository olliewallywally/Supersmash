; Rushdown — Fox archetype (Melee-accurate tuning).
; Physics source: meleelight (MIT © Will Blackett) — github.com/schmooblidon/meleelight
; Raw meleelight Fox stats: weight=75, gravity=0.23 u/f², terminalV=2.8 u/f,
;   fastFall=3.4 u/f, dashInit=2.02 u/f, dashMax=2.2 u/f, walkMax=1.6 u/f,
;   jumpSquat=3 f. Values scaled to px/s preserving Fox/Marth gravity ratio (2.71×).
;
; Design intent:
;   Lightest fighter (77). Heaviest gravity in the roster. Fastest run speed.
;   Dies early from knockback but controls neutral through speed and dash-dance.
;   Fox identity: heavy fall speed means short windows for being juggled;
;   high run speed enables immediate punish; low weight = high-risk, high-reward.
[gd_resource type="Resource" script_class="CharacterData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Character/CharacterData.cs" id="Script_CharacterData"]

[resource]
script = ExtResource("Script_CharacterData")

; ── Identity ──────────────────────────────────────────────────────────────────
; Melee Fox = 75 weight. Reduced from 82 → 77 to match the archetype more closely.
; Formula denominator (200/(77+100)) = 1.13. Takes ~13% MORE KB than mid-weight.
Weight = 77.0

; ── Ground Movement ───────────────────────────────────────────────────────────
; meleelight: walkMax=1.6, dashMax=2.2 u/f. Scale preserves Fox/Marth ratio.
WalkSpeed = 580.0
RunSpeed = 790.0
; Dash burst close to run (meleelight dashInit=2.02 ≈ dashMax=2.2).
InitialDashSpeed = 980.0
; High traction = snappy stops. Critical for tight dash-dancing.
GroundFriction = 0.24
TurnaroundFriction = 0.38

; ── Dash & Dash-Dance ─────────────────────────────────────────────────────────
; meleelight: dash phase frames 11–21 (11-frame initial dash).
InitialDashFrames = 11
; Wider reversal window — Rushdown can dash-dance earlier than most characters.
DashDanceWindowFrames = 14
FoxtrotCooldownFrames = 1

; ── Jumping ───────────────────────────────────────────────────────────────────
; meleelight jumpSquat = 3 frames. Fastest in the roster.
JumpSquatFrames = 3
; Fox's high short hop + heavy gravity creates the iconic short-hop aerial game.
FullHopVelocity = -1130.0
ShortHopVelocity = -720.0
AirJumpVelocity = -1060.0
MaxAirJumps = 1
; Full Melee-style momentum transfer — a max-speed dash-jump carries full velocity.
JumpMomentumTransfer = 1.0
MaxHorizontalJumpSpeed = 720.0

; ── Air Movement ──────────────────────────────────────────────────────────────
AirSpeed = 490.0
AirAcceleration = 0.10
AirFriction = 0.018

; ── Gravity & Fall ────────────────────────────────────────────────────────────
; meleelight Fox gravity = 0.23 u/f² — 2.71× heavier than Marth (0.085 u/f²).
; This is THE most defining Fox stat: must always attack or get punished landing.
Gravity = 3500.0
MaxFallSpeed = 2500.0
FastFallMultiplier = 1.7
; Fast-fall to 3800 px/s: Fox's fast-fall is one of the fastest in the roster.
FastFallMaxSpeed = 3800.0

; ── Landing Lag ───────────────────────────────────────────────────────────────
SoftLandingFrames = 2
HelplessLandingFrames = 20
LCancelMultiplier = 0.5

; ── Ledge ─────────────────────────────────────────────────────────────────────
LedgeGrabBoxOffset = Vector2(16, -8)
LedgeGrabBoxSize = Vector2(22, 36)
LedgeHangInvincibilityFrames = 30
LedgeRegrabCooldownFrames = 30
LedgeGetupFrames = 22

; ── Hurtbox Sizing ────────────────────────────────────────────────────────────
; Small and compact — harder to hit, shorter reach on attacks.
StandingHurtboxSize = Vector2(34, 78)
CrouchHurtboxSize = Vector2(38, 46)

; ── Shield ────────────────────────────────────────────────────────────────────
; Small shield health — cannot camp behind it. Movement is the defense.
ShieldMaxHealth = 44.0
ShieldDecayRate = 0.32
ShieldRegenRate = 0.18
ShieldBreakStunFrames = 180

; ── Combat ────────────────────────────────────────────────────────────────────
AttackerHitlagFrames = 3

; ── Respawn ───────────────────────────────────────────────────────────────────
SpawnInvincibilityFrames = 120

; ── Appearance — Fox-inspired: orange, white flight suit, green accents ────────
HairColor = Color(0.88, 0.52, 0.22, 1)
SkinColor = Color(0.96, 0.88, 0.74, 1)
ShirtColor = Color(0.90, 0.90, 0.86, 1)
PantsColor = Color(0.40, 0.52, 0.40, 1)
AccentColor = Color(0.85, 0.50, 0.20, 1)
HasSword = false
