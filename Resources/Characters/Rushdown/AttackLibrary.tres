; Rushdown (Fox) — AttackLibrary.
; Frame data sourced from Super Smash Bros. Melee community documentation.
; Kit philosophy: three low-commitment pokes build percent; UpTilt juggles;
; BackAir kills; ForwardSmash confirms at kill percent.
;
;   Jab        : frame 2 — fastest possible. Sets up jab-lock at low %.
;   NeutralAir : frame 3 — fast aerial, short-hop auto-cancel.
;   ForwardTilt: frame 8 — low angle (30°) keeps opponent grounded for follow-up dash.
;   UpTilt     : frame 7 — anti-air. High angle (85°) juggles. Combo starter above 0%.
;   BackAir    : frame 6 — kill aerial. 42° diagonal, high BKB. Confirms from NAir.
;   ForwardSmash: frame 11 — fastest smash. Confirms through conditioning; kills ~110%.
[gd_resource type="Resource" script_class="AttackLibrary" load_steps=18 format=3]

[ext_resource type="Script" path="res://Scripts/Character/Combat/AttackLibrary.cs" id="Script_AttackLibrary"]
[ext_resource type="Script" path="res://Scripts/Character/Combat/AttackData.cs"    id="Script_AttackData"]
[ext_resource type="Script" path="res://Scripts/Character/Combat/HitboxData.cs"    id="Script_HitboxData"]
[ext_resource type="PackedScene" path="res://Scenes/Projectiles/Laser.tscn"        id="Scene_Laser"]

; ── Jab ──────────────────────────────────────────────────────────────────────
; Melee Fox Jab1: frame 2 active, FAF 17. 2% damage, low BKB.
; Low BKB intentional — stays close for jab 2/3 follow-up.
[sub_resource type="Resource" id="HitboxData_Jab"]
script = ExtResource("Script_HitboxData")
Damage = 2.5
BaseKnockback = 12.0
KnockbackGrowth = 18.0
LaunchAngle = 50.0
AngleFlipsWithFacing = true
HitlagFrames = 2
HitstunFrames = 7
Type = 0
IgnoresDI = false
HitboxId = 0

