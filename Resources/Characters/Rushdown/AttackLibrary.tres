; Rushdown — AttackLibrary.
; Fast startup, low knockback. Combo-first kit — strings together 4-5 hits
; to build percent, then converts with ForwardSmash at kill percent.
;
; Balance philosophy:
;   Jab        : frame 2 — literally the fastest possible jab. Links into itself
;                3× at low percent (jab lock risk). Forces immediate shielding.
;   NeutralAir : fast, follows from short-hop. Combo filler.
;   ForwardTilt: frame 6 poke. Low recovery; safe on shield at full spacing.
;   ForwardSmash: frame 11 — fastest smash attack. Less raw power than Bruiser's
;                but confirms from conditioning opponents to shield jabs.
[gd_resource type="Resource" script_class="AttackLibrary" load_steps=12 format=3]

[ext_resource type="Script" path="res://Scripts/Character/Combat/AttackLibrary.cs" id="Script_AttackLibrary"]
[ext_resource type="Script" path="res://Scripts/Character/Combat/AttackData.cs"    id="Script_AttackData"]
[ext_resource type="Script" path="res://Scripts/Character/Combat/HitboxData.cs"    id="Script_HitboxData"]

; ── Jab ─────────────────────────────────────────────────────────────────────
; Frame 2 (StartupFrames=1). Minimal damage but forces instant reactions.
; Low BKB intentional — stays close for follow-ups. Does NOT kill.
[sub_resource type="Resource" id="HitboxData_Jab"]
script = ExtResource("Script_HitboxData")
Damage = 2.0
BaseKnockback = 10.0
KnockbackGrowth = 15.0
LaunchAngle = 50.0
AngleFlipsWithFacing = true
HitlagFrames = 2
HitstunFrames = 8
Type = 0
IgnoresDI = false
HitboxId = 0

[sub_resource type="Resource" id="AttackData_Jab"]
script = ExtResource("Script_AttackData")
AttackId = "Jab"
IsAerial = false
StartupFrames = 1
ActiveFrames = 2
RecoveryFrames = 8
HitboxNodeName = "JabHitbox"
Hitboxes = Array[Resource]([SubResource("HitboxData_Jab")])
HitstunMultiplier = 0.9

