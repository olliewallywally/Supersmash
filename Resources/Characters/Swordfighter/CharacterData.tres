; Swordfighter — Marth archetype (Melee-accurate tuning).
; Physics source: meleelight (MIT © Will Blackett) — github.com/schmooblidon/meleelight
; Raw meleelight Marth stats: weight=87, gravity=0.085 u/f² (0.37× Fox's 0.23),
;   terminalV≈1.8 u/f, dashMax=1.8 u/f, walkMax=1.6 u/f, jumpSquat=4 f.
; Fox/Marth gravity ratio = 2.71×. Marth gravity = Rushdown 3500 / 2.71 = 1292 → 1300.
;
; Design intent:
;   Mid-heavy (87). Lowest gravity in the roster — most float-y feel.
;   Long-reach sword creates a SPACING game entirely unlike Rushdown's rushdown.
;   TIPPER MECHANIC: ForwardTilt and ForwardSmash have a sweetspot (sword tip,
;   high knockback) and a sourspot (sword base, low knockback). Reward correct spacing.
;   Survives longer than Rushdown (87 vs 77 weight) but is punished for bad spacing.
[gd_resource type="Resource" script_class="CharacterData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Character/CharacterData.cs" id="Script_CharacterData"]

[resource]
script = ExtResource("Script_CharacterData")

; ── Identity ──────────────────────────────────────────────────────────────────
; Melee Marth = 87 weight. Mid-heavy — survives past 140% with good DI.
; Formula denominator (200/(87+100)) = 1.07. Takes ~7% MORE KB than mid-weight.
Weight = 87.0

; ── Ground Movement ───────────────────────────────────────────────────────────
; meleelight: walkMax=1.6 u/f (same as Fox), dashMax=1.8 u/f (18% slower than Fox).
WalkSpeed = 580.0
RunSpeed = 650.0
InitialDashSpeed = 760.0
; Slightly less traction than Rushdown — more slide on stop, but not Bruiser-slow.
GroundFriction = 0.18
TurnaroundFriction = 0.30

; ── Dash & Dash-Dance ─────────────────────────────────────────────────────────
; meleelight: dash frames 15–27 (15-frame initial dash, longer than Fox's 11).
InitialDashFrames = 15
; Narrower dash-dance window than Rushdown — Swordfighter spaces, doesn't dance.
DashDanceWindowFrames = 12
FoxtrotCooldownFrames = 2

; ── Jumping ───────────────────────────────────────────────────────────────────
; meleelight: jumpSquat=4. One extra frame vs Fox — subtle but readable timing diff.
JumpSquatFrames = 4
FullHopVelocity = -1020.0
ShortHopVelocity = -640.0
AirJumpVelocity = -980.0
MaxAirJumps = 1
; Marth has good momentum transfer — dash-jump is part of his spacing toolkit.
JumpMomentumTransfer = 0.90
MaxHorizontalJumpSpeed = 650.0

; ── Air Movement ──────────────────────────────────────────────────────────────
; Slightly higher air speed than Rushdown compensates for lower run speed.
AirSpeed = 460.0
AirAcceleration = 0.06
AirFriction = 0.015

; ── Gravity & Fall ────────────────────────────────────────────────────────────
; meleelight Marth gravity = 0.085 u/f², Fox = 0.23 u/f². Ratio = 0.37.
; Swordfighter gravity = 3500 × 0.37 = 1295 → 1300 px/s².
; This is the LOWEST gravity in the roster — Swordfighter floats visibly.
Gravity = 1300.0
MaxFallSpeed = 1700.0
; Swordfighter fast-fall is meaningful: drops quickly when committed.
FastFallMultiplier = 1.75
FastFallMaxSpeed = 2700.0

; ── Landing Lag ───────────────────────────────────────────────────────────────
SoftLandingFrames = 2
HelplessLandingFrames = 20
LCancelMultiplier = 0.5

; ── Ledge ─────────────────────────────────────────────────────────────────────
LedgeGrabBoxOffset = Vector2(18, -10)
LedgeGrabBoxSize = Vector2(24, 40)
LedgeHangInvincibilityFrames = 30
LedgeRegrabCooldownFrames = 30
LedgeGetupFrames = 26

; ── Hurtbox Sizing ────────────────────────────────────────────────────────────
; Taller frame to match the swordsman body type.
StandingHurtboxSize = Vector2(38, 90)
CrouchHurtboxSize = Vector2(42, 54)

; ── Shield ────────────────────────────────────────────────────────────────────
; Standard shield — Marth is not a shield-heavy character but has solid OOS options.
ShieldMaxHealth = 50.0
ShieldDecayRate = 0.28
ShieldRegenRate = 0.20
ShieldBreakStunFrames = 180

; ── Combat ────────────────────────────────────────────────────────────────────
; Sword strikes have slightly more hitlag — feels impactful on a clean tipper.
AttackerHitlagFrames = 4

; ── Respawn ───────────────────────────────────────────────────────────────────
SpawnInvincibilityFrames = 120

; ── Appearance — Marth-inspired: blue hair, blue tunic, gold tiara, Falchion ───
HairColor = Color(0.30, 0.46, 0.82, 1)
SkinColor = Color(0.95, 0.82, 0.70, 1)
ShirtColor = Color(0.20, 0.35, 0.70, 1)
PantsColor = Color(0.80, 0.80, 0.86, 1)
AccentColor = Color(0.86, 0.74, 0.30, 1)
HasSword = true
SwordLength = 70.0
SwordColor = Color(0.86, 0.89, 0.96, 1)
