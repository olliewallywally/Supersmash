; ── ForwardTilt — TIPPER ──────────────────────────────────────────────────────
; Ultimate Marth FTilt: startup f8, FAF 34. Two hitbox regions.
;
; TIPPER (sword tip) — high knockback, combo tool at low %, poke at mid %.
;   BKB=25, KBG=88: sends at 45° → can string into ForwardAir below ~60%.
;
; SOURSPOT (sword base) — low knockback. Safe poke, forces shield/bad option.
;   BKB=12, KBG=72: low enough that opponent stays grounded for follow-up dash.
;
; Scene setup: ForwardTiltTipper at sword tip, ForwardTiltBase along sword body.
[sub_resource type="Resource" id="HitboxData_FTilt_Tip"]
script = ExtResource("Script_HitboxData")
Damage = 12.0
BaseKnockback = 25.0
KnockbackGrowth = 88.0
LaunchAngle = 45.0
AngleFlipsWithFacing = true
HitlagFrames = 6
HitstunFrames = 22
Type = 0
IgnoresDI = false
HitboxId = 0

